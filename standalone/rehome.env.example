# rehome.env: write it yourself on the Home Assistant computer (nano rehome.env), then: chmod 600 rehome.env
# Home Assistant's address. On the same computer: http://localhost:<its port> (8123 unless you changed it, for example 80).
HA_URL=http://localhost:8123
# A long-lived access token: Home Assistant -> your profile -> Security -> Long-lived access tokens -> Create token.
HA_TOKEN=<paste-the-token-here>
# Optional. Usually you paste the key on the iPad (Settings -> Rehome License) instead; set here, the iPad can't change it.
# REHOME_LICENSE_KEY=RH-XXXX-XXXX-XXXX-XXXX
# Optional. A fixed pairing code (6 to 12 digits) instead of the one-time code in the log. Changing it forgets every paired iPad.
# REHOME_PAIRING_CODE=
# Optional. Names other than an IP, .local, .lan, .home, .internal or a bare name that the iPad uses to open Rehome.
# REHOME_ALLOWED_HOSTS=rehome.myhouse.example
# Optional. Home Assistant on https with a self-signed certificate.
# HA_INSECURE=1
